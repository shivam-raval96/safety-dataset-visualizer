{
  "name": "sites-project",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "embed": "node scripts/generate-embeddings.mjs && node scripts/write-comment-targets.mjs",
    "embed:distills": "node scripts/generate-distill-atlas.mjs",
    "discover:organisms": "python3 scripts/discover-organisms.py",
    "discover:papers": "python3 scripts/discover-papers.py",
    "dev": "npm run embed && vinext dev",
    "build": "npm run embed && vinext build",
    "build:static": "npm run embed && GITHUB_ACTIONS=true next build",
    "start": "vinext start",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern work",
    "build:comments": "node scripts/write-comment-targets.mjs && node scripts/build-comments-service.mjs",
    "sync:comments": "node scripts/sync-comments.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "umap-js": "^1.4.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@openai/sites-vite-plugin": "^0.1.0 || ^0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "^0.31.4",
    "drizzle-orm": "^0.44.7",
    "esbuild": "^0.27.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.3",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
